@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativePath)
            ? ""
            : $"?returnUrl={Uri.EscapeDataString(relativePath)}";

        Nav.NavigateTo($"/login{returnUrl}");
    }
}
