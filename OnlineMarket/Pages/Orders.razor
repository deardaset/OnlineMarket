@page "/orders"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject OrderService OrderSvc
@inject NavigationManager Nav

<PageTitle>Мои заказы — OnlineMarket</PageTitle>

<div class="flex items-center justify-between mb-8">
    <div>
        <h1 class="text-3xl font-bold">Мои заказы</h1>
        <p class="text-slate-400 text-sm mt-1">@(_orders?.Count ?? 0) заказов</p>
    </div>
    <button @onclick="CreateOrder"
            class="px-4 py-2 bg-violet-600 hover:bg-violet-500 rounded-lg font-medium text-sm transition">
        + Новый заказ
    </button>
</div>

@if (_loading)
{
    <div class="space-y-4">
        @for (int i = 0; i < 3; i++)
        {
            <div class="bg-slate-800 rounded-2xl h-32 animate-pulse"></div>
        }
    </div>
}
else if (_orders?.Count == 0)
{
    <div class="text-center mt-24 text-slate-400">
        <p class="text-4xl mb-4">📦</p>
        <p class="text-lg">Заказов пока нет</p>
        <a href="/products" class="text-violet-400 hover:underline text-sm">Перейти в каталог →</a>
    </div>
}
else if (_orders is null)
{
    <p class="text-center text-red-300 mt-24">Не удалось загрузить заказы.</p>
}
else
{
    <div class="space-y-4">
        @foreach (var o in _orders!)
        {
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6
                hover:border-slate-700 transition">
                <div class="flex items-start justify-between mb-4">
                    <div>
                        <p class="text-xs text-slate-500 font-mono">@o.Id</p>
                        <p class="text-sm text-slate-300 mt-0.5">
                            @o.Products.Count
                            @(o.Products.Count == 1 ? "товар" : o.Products.Count is 2 or 3 or 4 ? "товара" : "товаров")
                        </p>
                    </div>
                    <div class="flex gap-2">
                        <button @onclick="() => GoDetail(o.Id)"
                                class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg text-xs transition">
                            Подробнее
                        </button>
                        <button @onclick="() => Cancel(o.Id)"
                                class="px-3 py-1.5 bg-red-950 hover:bg-red-900 text-red-400
                            rounded-lg text-xs transition">
                            Отменить
                        </button>
                    </div>
                </div>

                <!-- Products preview -->
                @if (o.Products.Count > 0)
                {
                    <div class="flex flex-wrap gap-2">
                        @foreach (var op in o.Products.Take(4))
                        {
                            var p = op.Product;
                            <div class="flex items-center gap-2 bg-slate-800 rounded-lg px-3 py-1.5">
                                @if (p?.PhotoUrl is not null)
                                {
                                    <img src="@p.PhotoUrl" class="w-6 h-6 rounded object-cover" />
                                }
                                <span class="text-xs text-slate-300">@(p?.Name ?? "—")</span>
                                <span class="text-xs text-violet-400">@op.Price.ToString("C")</span>
                            </div>
                        }
                        @if (o.Products.Count > 4)
                        {
                            <div class="bg-slate-800 rounded-lg px-3 py-1.5 text-xs text-slate-400">
                                +@(o.Products.Count - 4) ещё
                            </div>
                        }
                    </div>

                    <p class="mt-3 text-right font-semibold text-white">
                        Итого: @(o.Products.Sum(op => op.Price).ToString("C"))
                    </p>
                }
            </div>
        }
    </div>
}

@code {
    List<OrderResponse>? _orders;
    bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _orders = await OrderSvc.GetMyOrdersAsync();
        _loading = false;
    }

    async Task CreateOrder()
    {
        var o = await OrderSvc.CreateOrderAsync();
        if (o is not null) Nav.NavigateTo($"/orders/{o.Id}");
    }

    void GoDetail(Guid id) => Nav.NavigateTo($"/orders/{id}");

    async Task Cancel(Guid id)
    {
        await OrderSvc.CancelOrderAsync(id);
        _orders = await OrderSvc.GetMyOrdersAsync();
    }
}
