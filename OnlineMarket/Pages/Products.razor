@page "/products"
@inject ProductService ProductSvc
@inject OrderService OrderSvc
@inject NavigationManager Nav

<PageTitle>Каталог — OnlineMarket</PageTitle>

<!-- Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold">Каталог</h1>
        <p class="text-slate-400 text-sm mt-1">@(_paged?.TotalCount ?? 0) товаров</p>
    </div>

    <!-- Category filter -->
    <div class="flex flex-wrap gap-2">
        <button @onclick='() => SetCategory(null)'
                class="@FilterCls(null)">
            Все
        </button>
        @foreach (var cat in Enum.GetValues<ProductCategory>())
        {
            var c = cat;
            <button @onclick="() => SetCategory(c)" class="@FilterCls(c)">
                @CategoryLabel(c)
            </button>
        }
    </div>
</div>

@if (_loading)
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        @for (int i = 0; i < 8; i++)
        {
            <div class="bg-slate-800 rounded-2xl h-64 animate-pulse"></div>
        }
    </div>
}
else if (_paged?.Items.Count == 0)
{
    <p class="text-center text-slate-400 mt-20">Товары не найдены.</p>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        @foreach (var p in _paged!.Items)
        {
            <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden
                hover:border-violet-700 hover:shadow-lg hover:shadow-violet-900/20 transition group">

                <!-- Image -->
                <div class="h-48 bg-slate-800 overflow-hidden">
                    @if (p.PhotoUrl is not null)
                    {
                        <img src="@p.PhotoUrl" alt="@p.Name"
                             class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center text-slate-600 text-4xl">
                            🛍
                        </div>
                    }
                </div>

                <!-- Info -->
                <div class="p-4">
                    <span class="text-xs text-violet-400 font-medium">@CategoryLabel(p.Category)</span>
                    <h3 class="font-semibold mt-0.5 line-clamp-1">@p.Name</h3>
                    @if (p.Description is not null)
                    {
                        <p class="text-slate-400 text-xs mt-1 line-clamp-2">@p.Description</p>
                    }

                    <div class="flex items-center justify-between mt-4">
                        <span class="text-lg font-bold text-white">@p.Price.ToString("C")</span>
                        <AuthorizeView>
                            <Authorized>
                                <button @onclick="() => AddToOrder(p)"
                                        class="px-3 py-1.5 bg-violet-600 hover:bg-violet-500 rounded-lg
                                    text-sm font-medium transition">
                                    В заказ
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (_paged!.TotalCount > _pageSize)
    {
        <div class="flex justify-center gap-3 mt-10">
            <button @onclick="PrevPage" disabled="@(_page == 1)"
                    class="px-4 py-2 bg-slate-800 rounded-lg disabled:opacity-40 hover:bg-slate-700 transition">
                ← Назад
            </button>
            <span class="px-4 py-2 text-slate-400 text-sm">Стр. @_page</span>
            <button @onclick="NextPage" disabled="@(_page * _pageSize >= _paged.TotalCount)"
                    class="px-4 py-2 bg-slate-800 rounded-lg disabled:opacity-40 hover:bg-slate-700 transition">
                Вперёд →
            </button>
        </div>
    }
}

<!-- Toast -->
@if (_toast is not null)
{
    <div class="fixed bottom-6 right-6 bg-violet-700 text-white px-5 py-3 rounded-xl shadow-xl text-sm animate-fade-in">
        @_toast
    </div>
}

@code {
    PagedResponse<ProductResponse>? _paged;
    bool _loading = true;
    int _page = 1;
    int _pageSize = 20;
    string? _sort;
    string? _search;
    ProductCategory? _category;
    string? _toast;

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        _loading = true;
        _paged = await ProductSvc.GetProductsAsync(_page, _pageSize, _sort, _search, _category);
        _loading = false;
    }

    async Task SetCategory(ProductCategory? c)
    {
        _category = c; _page = 1;
        await Load();
    }

    async Task PrevPage() { _page--; await Load(); }
    async Task NextPage() { _page++; await Load(); }

    async Task AddToOrder(ProductResponse p)
    {
        // Создаём новый заказ и добавляем товар
        var order = await OrderSvc.CreateOrderAsync();
        if (order is null) { ShowToast("Ошибка создания заказа"); return; }
        await OrderSvc.AddProductToOrderAsync(order.Id, p.Id);
        ShowToast($"«{p.Name}» добавлен в заказ");
    }

    void ShowToast(string msg)
    {
        _toast = msg;
        _ = Task.Delay(3000).ContinueWith(_ => { _toast = null; InvokeAsync(StateHasChanged); });
    }

    string FilterCls(ProductCategory? c) =>
        _category == c
            ? "px-3 py-1.5 bg-violet-600 text-white rounded-lg text-sm font-medium"
            : "px-3 py-1.5 bg-slate-800 text-slate-300 hover:bg-slate-700 rounded-lg text-sm transition";

    static string CategoryLabel(ProductCategory c) => c switch
    {
        ProductCategory.Food => "Еда",
        ProductCategory.Grocery => "Садоводство",
        ProductCategory.Drinks => "Напитки",
        ProductCategory.HouseHold => "Бытовая химия",
        ProductCategory.PersonalCare => "Средства ухода",
        ProductCategory.BabyProducts => "Товары для детей",
        ProductCategory.Medicine => "Медикаменты"
    };
}