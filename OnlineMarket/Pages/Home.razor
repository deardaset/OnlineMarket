@page "/"
@inject NavigationManager Nav

<PageTitle>OnlineMarket</PageTitle>

<div class="text-center mt-24">

    <h1 class="text-5xl font-bold bg-gradient-to-r from-violet-500 to-indigo-500 bg-clip-text text-transparent">
        OnlineMarket
    </h1>

    <p class="text-slate-400 mt-4 max-w-xl mx-auto">
        Удобный онлайн-магазин. Добавляйте товары, создавайте заказы
        и управляйте покупками в одном месте.
    </p>

    <div class="flex justify-center gap-4 mt-10">
        <button @onclick='() => Nav.NavigateTo("/products")'
                class="px-6 py-3 bg-violet-600 hover:bg-violet-500 rounded-xl font-semibold transition">
            Перейти в каталог
        </button>

        <button @onclick='() => Nav.NavigateTo("/login")'
                class="px-6 py-3 bg-slate-800 hover:bg-slate-700 rounded-xl font-semibold transition">
            Войти
        </button>
    </div>

</div>